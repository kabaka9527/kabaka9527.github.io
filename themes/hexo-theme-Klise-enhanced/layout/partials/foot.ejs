<footer class="footer">
  <style>
    /* 底部自定义信息区：统一行高与外边距，建立协调的字号层级 */
    .footer-custom {
      text-align: center;
      position: relative;
    }
    .footer-custom p {
      margin: 0.35rem 0;
      line-height: 1.7;
    }
    /* 主版权行：作为首层信息，字号略大且加重 */
    .footer-custom .copyright {
      font-size: 0.95rem;
      color: #333333;
      font-weight: 600;
      letter-spacing: 0.02em;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .footer-custom .tagline {
      font-size: 0.82rem;
      color: #4a4a4a;
      font-style: italic;
      font-weight: 700;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    /* 访问统计行：作为次层信息，字号收敛，保持轻盈 */
    .footer-custom .visitor-count {
      font-size: 0.82rem;
      color: #555555;
      font-weight: 500;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
    /* 备案信息：作为最末辅助信息，字号最小 */
    .footer-custom .icp-info {
      font-size: 0.75rem;
      color: #666666;
      font-weight: 500;
      margin-top: 0.5rem;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
    .footer-custom .icp-info a {
      color: #0056b3;
      text-decoration: underline;
      transition: all 0.3s ease;
      text-shadow: none;
    }
    .footer-custom .icp-info a:hover {
      color: #007bff;
      text-decoration: underline;
    }
    /* 数字部分：略加粗但颜色更柔和，避免绿色过于突兀 */
    .footer-custom .visitor-count span,
    #totalVisitors,
    #totalPageViews,
    #dailyVisitor {
      font-weight: 600;
      color: #2e7d4f;
      text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
    }
    /* 暗色模式：保持柔和可读，不使用纯黑与霓虹色 */
    body[data-theme="dark"] .footer-custom .copyright {
      color: #e8e6e3;
    }
    body[data-theme="dark"] .footer-custom .tagline,
    body[data-theme="dark"] .footer-custom .visitor-count {
      color: #b8b0a8;
    }
    body[data-theme="dark"] .footer-custom .icp-info {
      color: #9a928a;
    }
    body[data-theme="dark"] .footer-custom .icp-info a {
      color: #7eb6ff;
    }
    body[data-theme="dark"] .footer-custom .icp-info a:hover {
      color: #a8caff;
    }
    body[data-theme="dark"] .footer-custom .visitor-count span,
    body[data-theme="dark"] #totalVisitors,
    body[data-theme="dark"] #totalPageViews,
    body[data-theme="dark"] #dailyVisitor {
      color: #8ec8a5;
    }
    /* 移动端：整体字号略缩，间距收紧 */
    @media screen and (max-width: 768px) {
      .footer-custom .copyright {
        font-size: 0.88rem;
      }
      .footer-custom .visitor-count {
        font-size: 0.76rem;
      }
      .footer-custom .icp-info {
        font-size: 0.7rem;
      }
      .footer-custom p {
        margin: 0.3rem 0;
        line-height: 1.65;
      }
    }
  </style>

  <script defer src="https://events.vercount.one/js"></script>
  
  <div class="footer-custom">
    <p class="copyright">© 2021 <%= config.author %>のblog - 所有权利保留</p>
    <p class="visitor-count">
      页面访问量 <span id="vercount_value_page_pv">Loading</span>
    </p>
    <p class="visitor-count">
      站点总访问量 <span id="vercount_value_site_pv">Loading</span>
    </p>
    <p class="visitor-count">
      站点总访客数 <span id="vercount_value_site_uv">Loading</span>
    </p>
    <p class="icp-info"><a href="https://icp.gov.moe/?keyword=20255531" target="_blank">萌ICP备20255531号</a></p>
  </div>
</footer>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    function updateLocalStats() {
      let totalUV = parseInt(localStorage.getItem('localTotalVisitors') || '1024');
      if (localStorage.getItem('localVisitedBefore') !== 'true') {
        totalUV += 1;
        localStorage.setItem('localTotalVisitors', totalUV.toString());
        localStorage.setItem('localVisitedBefore', 'true');
      }
      var elTotalVisitors = document.getElementById('totalVisitors');
      if (elTotalVisitors) elTotalVisitors.textContent = totalUV;

      let totalPV = parseInt(localStorage.getItem('localTotalPageViews') || '1520');
      totalPV += 1;
      localStorage.setItem('localTotalPageViews', totalPV.toString());
      var elTotalPageViews = document.getElementById('totalPageViews');
      if (elTotalPageViews) elTotalPageViews.textContent = totalPV;

      const today = new Date().toDateString();
      const dailyData = JSON.parse(localStorage.getItem('localDailyVisitors') || '{"date":"", "count":0}');
      if (dailyData.date !== today) {
        dailyData.date = today;
        dailyData.count = 0;
      }
      dailyData.count += 1;
      var elDailyVisitor = document.getElementById('dailyVisitor');
      if (elDailyVisitor) elDailyVisitor.textContent = dailyData.count;
      localStorage.setItem('localDailyVisitors', JSON.stringify(dailyData));
    }

    updateLocalStats();
  });
</script>

<%- partial('partials/scripts') %>