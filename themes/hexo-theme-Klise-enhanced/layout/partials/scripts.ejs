
<%
  var bgImagesPayload = '{"light":[],"dark":[]}';
  if (typeof getBackgroundImages === "function") {
    bgImagesPayload = getBackgroundImages();
  }
%>
  <script>
    window.__BG_IMAGES__ = <%- bgImagesPayload %>;
  </script>
<% if (theme.scripts !== undefined && theme.scripts.length > 0) { %>
    <% theme.scripts.forEach(url => { %>
      <script src="<%=url%>"></script>
    <% }); %>
  <% } %>
  <script>
    window.FPConfig = {
      delay: 0,
      ignoreKeywords: [],
      maxRPS: 3,
      hoverDelay: 50,
    };
  </script>
  <script defer src="https://cdn.jsdelivr.net/gh/gijo-varghese/flying-pages@2.1.2/flying-pages.min.js"></script>