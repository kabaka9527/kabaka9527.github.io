
<!DOCTYPE html>
<html lang="<%=config.language%>">
<head>
  <%-partial('partials/head')%>

<script defer>
  document.addEventListener('visibilitychange', function () {
  if (document.visibilityState == 'hidden') {
      normal_title = document.title;
      document.title = '人有悲欢离合';
  } else document.title = normal_title;
});

</script>
  <body data-theme="light" class="notransition">
    <script defer>
      const body = document.body;
      const getTimeTheme = () => {
        const hour = new Date().getHours();
        return hour >= 7 && hour < 19 ? "light" : "dark";
      };
      const initTheme = (state) => {
        if (state === "dark") {
          body.setAttribute("data-theme", "dark");
        } else if (state === "light") {
          body.removeAttribute("data-theme");
        } else if (getTimeTheme() === "dark") {
          body.setAttribute("data-theme", "dark");
        } else {
          body.removeAttribute("data-theme");
        }
      };
      const initBackground = () => {
        const theme = body.getAttribute("data-theme") === "dark" ? "dark" : "light";
        const key = `bg:last:${theme}`;
        const cssVar = theme === "dark" ? "--bg-image-dark" : "--bg-image";
        try {
          const imageUrl = localStorage.getItem(key);
          if (imageUrl) body.style.setProperty(cssVar, `url("${imageUrl}")`);
        } catch (error) {
          // Ignore storage errors.
        }
      };

      initTheme(localStorage.getItem("theme"));
      initBackground();
      
      setTimeout(() => body.classList.remove("notransition"), 75);
    </script>
  <%-partial('partials/header')%>
  <%- body %>
  <%-partial('partials/foot')%>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
  document.body.classList.add('loaded');
});

  </script>
</body>
</html>
