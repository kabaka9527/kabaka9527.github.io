<div class="wrapper">
    <header class="header">
      <h1 class="header-title center"><%=page.title%></h1>
    </header>
    
      <main class="page-content" aria-label="Content">
      
        <div class="tags-container categories-container">
            <% site.categories.forEach(function(category, index) { %>
              <% const categoryColors = ['#c6911b', '#bf6f1c', '#ca2e14']; %>
              <a
                class="category-tag"
                href="<%= url_for(category.path) %>"
                style="font-size: <%= Math.min(18, 14 + category.length * 2) %>px; color: <%= categoryColors[index % categoryColors.length] %>;"
              >
                <%= category.name %> (<%= category.length %>)
              </a>
            <% }); %>
          </div>
         
     
      </main>
      
  </div>
  
